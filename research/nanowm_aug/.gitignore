# Generated data + run artefacts. Everything here is reproducible from the
# scripts in this directory; none of it belongs in git.
#
# imagined/ : imagined_rollout.py open-loop .npz shards (stage 1 output)
# cl/       : closed-loop branch pools / accepted rollouts
# diag/     : diagnostic figures, videos, calibration .npz
# logs/     : training / eval logs
# outputs/  : lerobot-train / lerobot-eval output dirs
# output/   : review videos and sheets (mp4, png, pkl)
# ckpt/     : local NanoWM checkpoint copies
imagined/
cl/
diag/
logs/
outputs/
output/
